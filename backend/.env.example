# PostgreSQL Connection
DATABASE_URL=postgresql://supplierhub:supplierhub_pass@localhost:5432/supplierhub_db

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# PromoStandards Default Credentials (optional - can be configured per supplier)
PROMOSTANDARDS_USERNAME=your_account_number
PROMOSTANDARDS_PASSWORD=your_password
